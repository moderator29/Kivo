# See ENVIRONMENT.md for what each of these does, where to get it, and which
# ones are actually required to run the app locally.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KIVO

# ---- Clerk (identity & auth — required) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- Supabase (application data — required) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Football data provider (optional — mock data used in dev if unset) ----
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=
FOOTBALL_LIVE_POLLING_ENABLED=false

# ---- AI Copilot (optional — feature stays Coming Soon if unset) ----
ANTHROPIC_API_KEY=

# ---- Email (optional — not yet wired) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Jobs / webhooks (optional — not yet used) ----
CRON_SECRET=
WEBHOOK_SECRET=
