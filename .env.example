# See ENVIRONMENT.md for what each of these does, where to get it, and which
# ones are actually required to run the app locally.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KIVO

# ---- Supabase (auth + application data — required) ----
# Since 2026-08-18 these are the app's ONLY identity credentials: Supabase Auth
# (email OTP) replaced Clerk entirely, so there is no separate auth provider key
# to set, and no third-party-auth step to complete in either dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Football data provider (optional — mock data used in dev if unset) ----
# Big Balls Sports Data (https://api.bigballsdata.com, Authorization: Bearer).
# Primary provider from 2026-08-19. SERVER-ONLY — never prefix with NEXT_PUBLIC_,
# which would put the key in the browser bundle where anybody can read and spend
# it. Names only in this file; the real value goes in .env.local or Vercel.
BBS_API_KEY=
# football-data.org v4 (https://api.football-data.org/v4, X-Auth-Token header).
# Secondary provider. SERVER-ONLY, same rule.
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
THE_SPORTS_DB_API_KEY=
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_LIVE_POLLING_ENABLED=false
# Extra image CDN hostnames (comma-separated, bare hostnames only). Feeds both
# next.config.ts's images.remotePatterns and the CSP img-src from one list.
# API-Football's host is built in; set this when switching to a provider whose
# image host isn't (e.g. thesportsdb) — see ENVIRONMENT.md. Build-time value.
FOOTBALL_IMAGE_HOSTS=

# ---- AI Copilot (optional — feature stays Coming Soon if unset) ----
ANTHROPIC_API_KEY=
AI_MODEL=

# ---- Email (optional — not yet wired; Supabase sends the sign-in OTP itself) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Vercel Cron (required for the automated live-sync worker to run — see
# ENVIRONMENT.md's "Automated live-sync worker" section and docs/LIVE_DATA.md) ----
CRON_SECRET=

# ---- Webhooks (optional — not yet used) ----
WEBHOOK_SECRET=
