# See ENVIRONMENT.md for what each of these does, where to get it, and which
# ones are actually required to run the app locally.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KIVO

# ---- Supabase (auth + application data — required) ----
# Since 2026-08-18 these are the app's ONLY identity credentials: Supabase Auth
# (email OTP) replaced Clerk entirely, so there is no separate auth provider key
# to set, and no third-party-auth step to complete in either dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Football data provider (optional — mock data used in dev if unset) ----
API_FOOTBALL_KEY=
THE_SPORTS_DB_API_KEY=
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_LIVE_POLLING_ENABLED=false

# ---- AI Copilot (optional — feature stays Coming Soon if unset) ----
ANTHROPIC_API_KEY=
AI_MODEL=

# ---- Email (optional — not yet wired; Supabase sends the sign-in OTP itself) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Vercel Cron (required for the automated live-sync worker to run — see
# ENVIRONMENT.md's "Automated live-sync worker" section and docs/LIVE_DATA.md) ----
CRON_SECRET=

# ---- Webhooks (optional — not yet used) ----
WEBHOOK_SECRET=
